<view class="page">
  <view class="hero">
    <view class="eyebrow">修图灵感小帮手</view>
    <view class="title">修图魔法铺</view>
    <view class="subtitle">把“想变好看一点”翻译成清楚的修图提示词，顺手整理风格、光线、色彩、留白和避坑要求。</view>
  </view>

  <view class="step-head">
    <view class="step-index">1</view>
    <view>
      <view class="section-title">选方向</view>
      <view class="section-hint">可以先选大概方向，后面也能自动识别。</view>
    </view>
  </view>
  <view class="category-grid">
    <block wx:for="{{categories}}" wx:key="id">
      <view class="category-card {{selectedCategory === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="selectCategory">
        <view class="category-name">{{item.name}}</view>
        <view class="category-desc">{{item.desc}}</view>
      </view>
    </block>
  </view>

  <view class="panel trends">
    <view class="advanced-head" bindtap="toggleTrends">
      <view>
        <view class="section-title">最近流行灵感</view>
        <view class="section-hint">把最近好看的修图玩法先藏在这里，想换口味再展开。</view>
      </view>
      <view class="chevron">{{trendsOpen ? "收起" : "展开"}}</view>
    </view>
    <view wx:if="{{trendsOpen}}" class="trend-grid">
      <block wx:for="{{trendTemplates}}" wx:key="name">
        <view class="trend-card {{selectedCategory === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="selectTrendTemplate">
          <view class="trend-top">
            <view class="trend-name">{{item.name}}</view>
            <view class="trend-tag">{{item.tag}}</view>
          </view>
          <view class="trend-desc">{{item.desc}}</view>
        </view>
      </block>
    </view>
  </view>

  <view class="panel">
    <view class="step-head inner">
      <view class="step-index">2</view>
      <view>
        <view class="section-title">写想法</view>
        <view class="section-hint">例如：把这张咖啡店照片做成日系手账注解风，底部留白方便放文字。</view>
      </view>
    </view>
    <textarea class="idea" value="{{form.rawIdea}}" placeholder="写下你想让照片变成什么感觉，比如清透自然、胶片随拍、密集涂鸦覆盖、去掉杂物..." bindinput="onRawIdeaInput" />
    <view class="example-toggle" bindtap="toggleExamples">
      <view>
        <view class="example-title">需要一点灵感？</view>
        <view class="example-hint">看看可直接套用的想法例子</view>
      </view>
      <view class="example-state">{{examplesOpen ? "收起 ↑" : "展开 ↓"}}</view>
    </view>
    <view wx:if="{{examplesOpen}}" class="chip-row">
      <block wx:for="{{effectChips}}" wx:key="*this">
        <view class="chip" data-text="{{item}}" bindtap="addEffectChip">{{item}}</view>
      </block>
    </view>
    <view class="actions">
      <button class="btn primary" bindtap="analyzeOverwrite">智能拆解并覆盖填充</button>
      <button class="btn ghost" bindtap="analyzeFillEmpty">只补空项</button>
      <button class="btn soft" bindtap="clearAll">清空</button>
    </view>
  </view>

  <view class="panel advanced">
    <view class="advanced-head" bindtap="toggleAdvanced">
      <view>
        <view class="section-title">高级设置</view>
        <view class="section-hint">想控制主体、光线、注解、禁止项时再展开。</view>
      </view>
      <view class="chevron">{{advancedOpen ? "收起" : "展开"}}</view>
    </view>
    <view wx:if="{{advancedOpen}}" class="fields">
      <block wx:for="{{fields}}" wx:key="key">
        <view class="field">
          <view class="label">{{item.label}}</view>
          <textarea wx:if="{{item.multiline}}" class="field-input textarea" value="{{form[item.key]}}" data-key="{{item.key}}" bindinput="onFieldInput" />
          <input wx:else class="field-input" value="{{form[item.key]}}" data-key="{{item.key}}" bindinput="onFieldInput" />
        </view>
      </block>
    </view>
  </view>

  <view class="panel result-card">
    <view class="result-head">
      <view class="step-head inner no-margin">
        <view class="step-index">3</view>
        <view>
          <view class="section-title">复制结果</view>
          <view class="section-hint">输出默认包含底部 240px / 12% 安全留白规则。</view>
        </view>
      </view>
      <view class="score">{{filledScore}}%</view>
    </view>
    <view class="tabs">
      <block wx:for="{{tabs}}" wx:key="id">
        <view class="tab {{activeTab === item.id ? 'on' : ''}}" data-id="{{item.id}}" bindtap="setTab">{{item.name}}</view>
      </block>
    </view>
    <view class="output">{{currentOutput}}</view>
    <view class="actions">
      <button class="btn primary" bindtap="copyCurrent">复制当前</button>
      <button class="btn ghost" bindtap="copyAll">复制全部</button>
    </view>
  </view>
</view>
