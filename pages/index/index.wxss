.page {
  min-height: 100vh;
  padding: 28rpx;
  padding-bottom: 80rpx;
  box-sizing: border-box;
}

.hero {
  padding: 18rpx 4rpx 30rpx;
}

.eyebrow {
  display: inline-flex;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #ecfeff;
  color: #0e7490;
  font-size: 23rpx;
  font-weight: 800;
}

.title {
  margin-top: 22rpx;
  font-size: 48rpx;
  line-height: 1.14;
  font-weight: 900;
  color: #111827;
}

.subtitle {
  margin-top: 16rpx;
  color: #64748b;
  font-size: 28rpx;
  line-height: 1.65;
}

.panel {
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(226, 232, 240, 0.9);
  border-radius: 24rpx;
  box-shadow: 0 18rpx 50rpx rgba(15, 23, 42, 0.07);
  padding: 30rpx;
  margin-bottom: 26rpx;
}

.step-head {
  display: flex;
  gap: 18rpx;
  align-items: flex-start;
  margin: 8rpx 4rpx 18rpx;
}

.step-head.inner {
  margin: 0 0 18rpx;
}

.step-head.no-margin {
  margin: 0;
}

.step-index {
  flex: 0 0 48rpx;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #111827;
  color: #fff;
  text-align: center;
  line-height: 48rpx;
  font-size: 24rpx;
  font-weight: 900;
}

.section-title {
  font-size: 32rpx;
  line-height: 1.25;
  font-weight: 850;
  color: #111827;
}

.section-hint {
  margin-top: 8rpx;
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.5;
}

.category-scroll {
  white-space: nowrap;
  margin-bottom: 28rpx;
}

.category-row {
  display: flex;
  gap: 16rpx;
}

.category-card {
  display: inline-flex;
  flex-direction: column;
  width: 242rpx;
  min-height: 150rpx;
  box-sizing: border-box;
  padding: 22rpx;
  border-radius: 22rpx;
  background: #fff;
  border: 2rpx solid #e5e7eb;
  white-space: normal;
}

.category-card.active {
  border-color: #14b8a6;
  background: #f0fdfa;
  box-shadow: 0 10rpx 30rpx rgba(20, 184, 166, 0.16);
}

.category-name {
  font-size: 26rpx;
  line-height: 1.25;
  font-weight: 850;
  color: #111827;
}

.category-desc {
  margin-top: 12rpx;
  color: #64748b;
  font-size: 22rpx;
  line-height: 1.4;
}

.idea {
  width: 100%;
  min-height: 210rpx;
  box-sizing: border-box;
  border-radius: 20rpx;
  background: #f8fafc;
  border: 1rpx solid #e5e7eb;
  padding: 24rpx;
  font-size: 29rpx;
  line-height: 1.6;
  color: #111827;
}

.chip-row {
  margin-top: 18rpx;
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.chip {
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  background: #f1f5f9;
  color: #334155;
  font-size: 24rpx;
  font-weight: 750;
}

.actions {
  margin-top: 22rpx;
  display: flex;
  gap: 14rpx;
  flex-wrap: wrap;
}

.btn {
  min-height: 76rpx;
  padding: 0 26rpx;
  border-radius: 18rpx;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 76rpx;
}

.btn::after {
  border: 0;
}

.primary {
  background: #0f766e;
  color: #fff;
}

.ghost {
  background: #fff;
  color: #0f766e;
  border: 1rpx solid #99f6e4;
}

.soft {
  background: #f1f5f9;
  color: #334155;
}

.advanced {
  padding-top: 28rpx;
}

.advanced-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.chevron {
  flex-shrink: 0;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #f8fafc;
  color: #0f766e;
  font-size: 24rpx;
  font-weight: 800;
}

.fields {
  margin-top: 12rpx;
}

.field {
  margin-top: 22rpx;
}

.label {
  margin-bottom: 10rpx;
  color: #475569;
  font-size: 25rpx;
  font-weight: 750;
}

.field-input {
  min-height: 78rpx;
  width: 100%;
  box-sizing: border-box;
  border-radius: 18rpx;
  background: #f8fafc;
  border: 1rpx solid #e5e7eb;
  padding: 0 22rpx;
  font-size: 28rpx;
  color: #111827;
}

.textarea {
  min-height: 130rpx;
  padding: 20rpx 22rpx;
  line-height: 1.55;
}

.result-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.score {
  flex-shrink: 0;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #ecfeff;
  color: #0e7490;
  font-size: 24rpx;
  font-weight: 800;
}

.tabs {
  margin-top: 24rpx;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  padding: 8rpx;
  border-radius: 18rpx;
  background: #f1f5f9;
}

.tab {
  text-align: center;
  padding: 16rpx 6rpx;
  border-radius: 14rpx;
  color: #64748b;
  font-size: 24rpx;
  font-weight: 800;
}

.tab.on {
  background: #fff;
  color: #111827;
  box-shadow: 0 4rpx 14rpx rgba(15, 23, 42, 0.08);
}

.output {
  margin-top: 22rpx;
  min-height: 430rpx;
  max-height: 720rpx;
  overflow: auto;
  white-space: pre-wrap;
  word-break: break-word;
  border-radius: 20rpx;
  background: #111827;
  color: #f8fafc;
  padding: 26rpx;
  font-size: 25rpx;
  line-height: 1.7;
}
