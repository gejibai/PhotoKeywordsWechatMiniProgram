.page {
  min-height: 100vh;
  padding: 28rpx;
  padding-bottom: 80rpx;
  box-sizing: border-box;
  background: #f5efd9;
}

.hero {
  padding: 18rpx 4rpx 28rpx;
}

.eyebrow {
  display: inline-flex;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #fff9e7;
  border: 1rpx solid #d6bf80;
  color: #6f5528;
  font-size: 23rpx;
  font-weight: 800;
}

.title {
  margin-top: 22rpx;
  font-size: 48rpx;
  line-height: 1.14;
  font-weight: 900;
  color: #2f2617;
}

.subtitle {
  margin-top: 16rpx;
  color: #7a6a4b;
  font-size: 28rpx;
  line-height: 1.65;
}

.panel {
  background: rgba(255, 251, 238, 0.94);
  border: 1rpx solid #dfd0a5;
  border-radius: 24rpx;
  box-shadow: 0 14rpx 34rpx rgba(107, 78, 29, 0.08);
  padding: 30rpx;
  margin-bottom: 26rpx;
}

.step-head {
  display: flex;
  gap: 18rpx;
  align-items: flex-start;
  margin: 8rpx 4rpx 18rpx;
}

.step-head.inner {
  margin: 0 0 18rpx;
}

.step-head.no-margin {
  margin: 0;
}

.step-index {
  flex: 0 0 48rpx;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #3b2f1d;
  color: #fff8de;
  text-align: center;
  line-height: 48rpx;
  font-size: 24rpx;
  font-weight: 900;
}

.section-title {
  font-size: 32rpx;
  line-height: 1.25;
  font-weight: 850;
  color: #2f2617;
}

.section-hint {
  margin-top: 8rpx;
  color: #85765a;
  font-size: 24rpx;
  line-height: 1.5;
}

.category-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 28rpx;
}

.category-card {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  width: calc((100% - 24rpx) / 3);
  min-height: 188rpx;
  box-sizing: border-box;
  padding: 18rpx;
  border-radius: 24rpx;
  background: #fffaf0;
  border: 2rpx solid #dfd0a5;
  box-shadow: 0 8rpx 22rpx rgba(107, 78, 29, 0.05);
}

.category-card.active {
  border-color: #a88a43;
  background: #fff4cf;
  box-shadow: 0 12rpx 28rpx rgba(120, 86, 28, 0.14);
}

.category-name {
  font-size: 25rpx;
  line-height: 1.28;
  font-weight: 850;
  color: #3b2f1d;
}

.category-desc {
  margin-top: 12rpx;
  color: #8a7855;
  font-size: 21rpx;
  line-height: 1.42;
}

.trends {
  margin-top: -4rpx;
}

.trend-grid {
  margin-top: 22rpx;
  display: grid;
  grid-template-columns: 1fr;
  gap: 14rpx;
}

.trend-card {
  padding: 20rpx;
  border-radius: 24rpx;
  background: #fff8dd;
  border: 2rpx solid #dfd0a5;
  box-shadow: 0 8rpx 20rpx rgba(107, 78, 29, 0.05);
}

.trend-card.active {
  border-color: #a88a43;
  background: #fff0bf;
}

.trend-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}

.trend-name {
  color: #3b2f1d;
  font-size: 28rpx;
  font-weight: 900;
}

.trend-tag {
  flex-shrink: 0;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #3b2f1d;
  color: #fff8de;
  font-size: 21rpx;
  font-weight: 850;
}

.trend-desc {
  margin-top: 12rpx;
  color: #7a6a4b;
  font-size: 24rpx;
  line-height: 1.5;
}

.idea {
  width: 100%;
  min-height: 210rpx;
  box-sizing: border-box;
  border-radius: 24rpx;
  background: #fffdf6;
  border: 1rpx solid #dfd0a5;
  padding: 24rpx;
  font-size: 29rpx;
  line-height: 1.6;
  color: #2f2617;
}

.example-toggle {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 4rpx 2rpx 0;
}

.example-title {
  color: #6f5528;
  font-size: 24rpx;
  font-weight: 800;
}

.example-hint {
  margin-top: 4rpx;
  color: #9a875f;
  font-size: 21rpx;
  line-height: 1.35;
}

.example-state {
  flex-shrink: 0;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #fff8dd;
  border: 1rpx solid #d7bf7f;
  color: #6f5528;
  font-size: 24rpx;
  font-weight: 850;
}

.chip-row {
  margin-top: 14rpx;
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.chip {
  max-width: 100%;
  box-sizing: border-box;
  padding: 14rpx 22rpx;
  border-radius: 999rpx;
  background: #fff8dd;
  border: 2rpx solid #c7ad6b;
  color: #5f4b24;
  font-size: 24rpx;
  font-weight: 750;
  line-height: 1.45;
}

.actions {
  margin-top: 22rpx;
  display: flex;
  gap: 14rpx;
  flex-wrap: wrap;
}

.btn {
  min-height: 76rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 76rpx;
}

.btn::after {
  border: 0;
}

.primary {
  background: #3b2f1d;
  color: #fff8de;
}

.ghost {
  background: #fff8dd;
  color: #5f4b24;
  border: 1rpx solid #c7ad6b;
}

.soft {
  background: #efe3bf;
  color: #5f4b24;
}

.advanced {
  padding-top: 28rpx;
}

.advanced-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.chevron {
  flex-shrink: 0;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #fff8dd;
  border: 1rpx solid #c7ad6b;
  color: #5f4b24;
  font-size: 24rpx;
  font-weight: 800;
}

.fields {
  margin-top: 12rpx;
}

.field {
  margin-top: 22rpx;
}

.label {
  margin-bottom: 10rpx;
  color: #6f5c36;
  font-size: 25rpx;
  font-weight: 750;
}

.field-input {
  min-height: 78rpx;
  width: 100%;
  box-sizing: border-box;
  border-radius: 20rpx;
  background: #fffdf6;
  border: 1rpx solid #dfd0a5;
  padding: 0 22rpx;
  font-size: 28rpx;
  color: #2f2617;
}

.textarea {
  min-height: 130rpx;
  padding: 20rpx 22rpx;
  line-height: 1.55;
}

.result-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.score {
  flex-shrink: 0;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #fff8dd;
  border: 1rpx solid #c7ad6b;
  color: #5f4b24;
  font-size: 24rpx;
  font-weight: 800;
}

.tabs {
  margin-top: 24rpx;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  padding: 8rpx;
  border-radius: 999rpx;
  background: #efe3bf;
}

.tab {
  text-align: center;
  padding: 16rpx 6rpx;
  border-radius: 999rpx;
  color: #7a6a4b;
  font-size: 24rpx;
  font-weight: 800;
}

.tab.on {
  background: #fff8dd;
  color: #3b2f1d;
  box-shadow: 0 4rpx 14rpx rgba(107, 78, 29, 0.1);
}

.output {
  margin-top: 22rpx;
  min-height: 430rpx;
  max-height: 720rpx;
  overflow: auto;
  white-space: pre-wrap;
  word-break: break-word;
  border-radius: 24rpx;
  background: #3b2f1d;
  color: #fff8de;
  padding: 26rpx;
  font-size: 25rpx;
  line-height: 1.7;
}
